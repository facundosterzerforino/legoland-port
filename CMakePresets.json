{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc6",
      "displayName": "MSVC6 (wibo)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "${sourceDir}/cmake/msvc6-toolchain.cmake"
    },
    {
      "name": "clang-cl-x86",
      "displayName": "Port: clang-cl, 32-bit Windows (runnable)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-clang-x86",
      "toolchainFile": "${sourceDir}/cmake/clang-cl-x86.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "clang-cl-x64",
      "displayName": "Port: clang-cl, 64-bit Windows (phase 8)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-clang-x64",
      "toolchainFile": "${sourceDir}/cmake/clang-cl-x64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux",
      "displayName": "Port: clang, 64-bit Linux (phase 8)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-linux",
      "toolchainFile": "${sourceDir}/cmake/linux.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc6",
      "configurePreset": "msvc6"
    },
    {
      "name": "clang-cl-x86",
      "configurePreset": "clang-cl-x86"
    },
    {
      "name": "clang-cl-x64",
      "configurePreset": "clang-cl-x64"
    },
    {
      "name": "linux",
      "configurePreset": "linux"
    }
  ]
}
