#!/bin/sh
# The Linux release build's C++ compiler (cmake/linux-portable.cmake): Zig's clang, linking against glibc 2.31 (Ubuntu 20.04,
# Debian 11 and later run it) whatever this system's is. The system's own headers come after Zig's C library's: SDL
# needs X11's and Wayland's (it loads their libraries at run time). ZIG names the zig executable, else ~/zig/zig.
exec "${ZIG:-$HOME/zig/zig}" c++ -target x86_64-linux-gnu.2.31 -idirafter /usr/include -idirafter /usr/include/x86_64-linux-gnu "$@"
